# Normalise line endings: LF in the repository and in the working tree,
# so shell scripts and Docker files work the same on Windows, Linux and macOS.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files: never touch line endings, never diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.zip   binary
*.gz    binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary

# Lock files: collapse in GitHub diffs
package-lock.json linguist-generated=true
