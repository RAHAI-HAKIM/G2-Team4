# ---------------------------------------------------------------------------
# Crucible — ignore rules for the whole monorepo
# Keep secrets, generated files and local data OUT of git (SRS SEC-08).
# ---------------------------------------------------------------------------

# --- Secrets and local configuration --------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# --- Python / Django (backend/) ---------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
env/
.python-version
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.sqlite3
backend/staticfiles/
backend/media/
local_settings.py

# --- Node / React (frontend/, e2e/) -----------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Playwright (e2e/) ------------------------------------------------------
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.auth/

# --- Infrastructure / runtime data -----------------------------------------
infra/data/
infra/backups/
*.dump
*.sql.gz
*.log
logs/

# --- Editors and OS ---------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Office lock files (docs/) ----------------------------------------------
~$*
